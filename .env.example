# Read by systemd (EnvironmentFile) on the server and by `uv run --env-file .env` in dev.
# Whole-line comments only: systemd would keep an inline "# ..." as part of the value.

# Laravel sends this as X-Service-Key. Empty = no auth (local dev only).
OCR_SERVICE_KEY=change-me
OCR_DATA_DIR=/var/lib/eagleye-ocr

# DocHub (Sterlite). The server must reach this host (internal network / VPN).
DOCHUB_URL=https://dochub-uat.sterlitepower.com/DeepApp
DOCHUB_USERNAME=
# exactly as DocHub issued it (it is already an encrypted string)
DOCHUB_PASSWORD=
# folders to read, DocHub path syntax; several separated by ;
DOCHUB_ROOTS=Sterlite Power>Inhouse Design Solution>Infra>Documents for Execution>Anantapur-II REZ Transmission Limited

# dev only: read PDFs from a local folder instead of DocHub
OCR_DRAWINGS_DIR=

# Tesseract: one thread per process (much faster with the per-cell reads)
OMP_THREAD_LIMIT=1
OCR_DPI=400
OCR_THREADS=4
